# Groq — clave en https://console.groq.com/keys (empieza por gsk_)
VITE_GROQ_API_KEY=YOUR_GROQ_API_KEY

# Modelo Groq (chat completions). Ejemplos: llama-3.3-70b-versatile, llama-3.1-8b-instant
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Nombre del e-commerce
SHOP_NAME=FusaShop

# URL base del sitio
SHOP_BASE_URL=https://fusashop.com
