# API Key de Google AI Studio (Gemini) — backend o documentación
GEMINI_API_KEY=TU_API_KEY_AQUI

# Modelo (los IDs cambian; evita gemini-1.5-flash — ya no existe en la API).
# Ejemplos: gemini-2.0-flash-001, gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash-001

# Nombre del e-commerce
SHOP_NAME=FusaShop

# URL base del sitio
SHOP_BASE_URL=https://fusashop.com

# --- Frontend (Vite / Laravel) ---
VITE_GEMINI_API_KEY=TU_API_KEY_AQUI
VITE_GEMINI_MODEL=gemini-2.0-flash-001
